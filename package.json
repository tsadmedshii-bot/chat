{"dependencies":{"bcryptjs":"^2.4.3","cors":"^2.8.5","drizzle-orm":"^0.36.4","express":"^4.21.2","pg":"^8.13.1"},"description":"Чат — орчин үеийн 2 өрөөтэй чат + Meta маягийн пост (standalone web app, Node + Express + React + PostgreSQL)","devDependencies":{"@types/bcryptjs":"^2.4.6","@types/cors":"^2.8.17","@types/express":"^4.17.21","@types/node":"^22.10.0","@types/pg":"^8.11.10","@types/react":"^18.3.12","@types/react-dom":"^18.3.1","@vitejs/plugin-react":"^4.3.4","concurrently":"^9.1.0","drizzle-kit":"^0.28.1","react":"^18.3.1","react-dom":"^18.3.1","tsx":"^4.19.2","typescript":"^5.6.3","vite":"^5.4.11"},"engines":{"node":">=20"},"name":"chat","private":true,"scripts":{"build":"npm run build:client && npm run build:server","build:client":"vite build --config client/vite.config.ts","build:server":"tsc -p tsconfig.server.json","db:migrate":"tsx server/src/migrate.ts","dev":"concurrently \"npm run dev:server\" \"npm run dev:client\"","dev:client":"vite --config client/vite.config.ts","dev:server":"tsx watch server/src/index.ts","start":"node dist/server/src/index.js","typecheck":"tsc -p tsconfig.server.json --noEmit && tsc -p client/tsconfig.json --noEmit"},"type":"commonjs","version":"1.0.0"}